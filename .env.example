# MongoDB Connection
# Get this from Railway MongoDB service → Variables → MONGO_URL
MONGODB_URI=your_mongodb_connection_string_here

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
# Optional: /api/ai/ask tier=cheap and /api/ai/triage (defaults to GEMINI_MODEL or gemini-2.0-flash)
# GEMINI_MODEL_CHEAP=gemini-2.0-flash
# Optional override for NFT/persona PNG generation; server tries a built-in chain if unset or if a model fails
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Server Configuration
PORT=8080
NODE_ENV=production

# Frontend Origins (for CORS)
# Set to your Vercel frontend URL
FRONTEND_ORIGIN=https://dpal-front-end.vercel.app
FRONTEND_ORIGIN_2=

# --- Authentication (JWT access + refresh sessions, bcrypt passwords) ---
# Required in production: 32+ character random strings (openssl rand -base64 48)
JWT_SECRET=
# Optional: separate secret for refresh token signing; defaults to JWT_SECRET
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_MS=604800000
BCRYPT_ROUNDS=12
# First signup with this exact email becomes admin (optional)
BOOTSTRAP_ADMIN_EMAIL=

# Note: Railway will auto-detect these variables.
# Make sure to set the correct values in Railway → Variables tab.
# Localhost values are only for local development.
